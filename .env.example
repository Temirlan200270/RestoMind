# === Приложение ===
APP_NAME=RestoMind
APP_DEBUG=true

# === Режим БД ===
# "sqlite" — работает без установки (для разработки)
# "postgres" — для продакшена
DB_MODE=sqlite

# Полный URL PostgreSQL (если задан — игнорируются POSTGRES_* ниже; так задаёт Render/Railway)
# DATABASE_URL=postgresql://user:pass@host:5432/restomind_db

# === PostgreSQL (только если DB_MODE=postgres и нет DATABASE_URL) ===
POSTGRES_USER=restomind
POSTGRES_PASSWORD=restomind_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=restomind_db

# === Redis (опционально) ===
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# === Gemini (Google AI) ===
GEMINI_API_KEY=

# === WhatsApp (Meta API) ===
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=your_random_verify_token_here
WHATSAPP_PHONE_NUMBER_ID=
# Публичный URL без слэша на конце — для подсказки вебхука в админке (Meta Callback URL = PUBLIC_BASE_URL/api/whatsapp/webhook)
PUBLIC_BASE_URL=

# Telegram — оповещения при эскалации на оператора (escalate → HUMAN_MODE)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ADMIN_CHAT_ID=123456789
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# === iiko Cloud API (опционально) ===
IIKO_API_LOGIN=
IIKO_ORGANIZATION_ID=

# === Админ-панель ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_password_here
# Секрет cookie-сессии и подписи WS-токена (в проде — случайная строка 32+ байт)
SESSION_SECRET=

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=20

# === Sentry (опционально) ===
SENTRY_DSN=

# === Production Deploy (docker-compose.prod.yml) ===
DOMAIN=restomind.example.com
ACME_EMAIL=admin@example.com
