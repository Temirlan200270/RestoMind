# === Приложение ===
APP_NAME=RestoMind
APP_DEBUG=true
# Версия в OpenAPI / блок «Окружение» в админке (можно подставлять из CI)
# APP_VERSION=0.1.0

# Ретеншн chat_logs: удаление записей старше N суток (0 = выключено). Интервал фоновой задачи — секунды.
# CHAT_LOG_RETENTION_DAYS=90
# CHAT_LOG_RETENTION_INTERVAL_SECONDS=86400

# === Режим БД ===
# "sqlite" — работает без установки (для разработки)
# "postgres" — для продакшена
DB_MODE=sqlite

# Полный URL PostgreSQL (если задан — игнорируются POSTGRES_* ниже; так задаёт Render/Railway/Supabase)
# Supabase: Project Settings → Database → URI (часто с ?sslmode=require). Деплой и дамп: docs/SUPABASE_MIGRATION.md
# DATABASE_URL=postgresql://user:pass@host:5432/restomind_db
# Редко нужно: если TLS к Postgres падает на verify (например, нестандартная цепочка у pooler/proxy).
# По умолчанию лучше НЕ включать. Альтернатива для совместимости: ALEMBIC_SSL_NO_VERIFY=true (только миграции).
# DATABASE_SSL_SKIP_VERIFY=false

# === PostgreSQL (только если DB_MODE=postgres и нет DATABASE_URL) ===
POSTGRES_USER=restomind
POSTGRES_PASSWORD=restomind_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=restomind_db

# === Redis (опционально) ===
REDIS_ENABLED=false
# Только RAM процесса: не подключаться к Redis (тесты, исчерпана квота Upstash). Имеет приоритет над REDIS_ENABLED.
# REDIS_MEMORY_ONLY=true
# Полный URL (приоритет над HOST/PORT): для Upstash скопируйте «Redis Connect» (rediss://default:ПАРОЛЬ@host:6379).
# Upstash REST (HTTPS + токен) не подходит для Pub/Sub админки — нужен именно TCP rediss://.
# REDIS_URL=rediss://default:YOUR_PASSWORD@xxxx.upstash.io:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Только если TLS к Redis падает на проверке сертификата (по умолчанию false)
# REDIS_SSL_SKIP_VERIFY=false

# === Очередь ARQ (отдельный worker-процесс) ===
# В APP_ENV=production|staging веб-процесс при старте проверяет доступность Redis+ARQ.
# Локально без worker входящие WhatsApp/ретраи не обработаются (нет fallback на BackgroundTasks).
# ARQ_ENABLED=true
# ARQ_QUEUE_NAME=restomind
# Запуск worker (из корня репозитория, те же REDIS_* что и у приложения):
#   python -m arq app.worker.WorkerSettings

# === Админка (legacy-вход по env) ===
# Для локальной разработки можно оставить дефолты из кода, но в проде обязательно задайте свои значения.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=restomind
#
# ВАЖНО для продакшена: единый секрет подписи cookie-сессий и WS-токенов.
# SESSION_SECRET=long_random_string_here
#
# Super Admin (опционально): legacy-вход с `is_superadmin=true` (удобно для доступа к /superadmin).
# SUPERADMIN_USERNAME=
# SUPERADMIN_PASSWORD=

# === AI-провайдер (мозг и голос) ===
# Что отвечает клиентам и распознаёт голос:
#   openai — GPT (structured output) + Whisper (STT) — нужен OPENAI_API_KEY
#   gemini — Google Gemini (text + multimodal audio STT) — нужен GEMINI_API_KEY
# AI_PROVIDER=openai

# === OpenAI (если AI_PROVIDER=openai) ===
# Чат (structured output по схеме AIBrainResponse) + Whisper для голосовых
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Совместимый прокси / Azure (иначе пусто = api.openai.com)
# OPENAI_BASE_URL=

# === Google Gemini (если AI_PROVIDER=gemini) ===
# Один ключ — и текст, и распознавание голосовых (Gemini multimodal). Без OpenAI/Whisper.
# GEMINI_API_KEY=

# === Twilio Voice (PSTN, опционально) ===
# Вебхук номера: POST https://<PUBLIC_BASE_URL>/api/whatsapp/voice/incoming
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Размер буфера μ-law перед STT (~8000 байт/сек): TWILIO_VOICE_BUFFER_BYTES=24000

# === WhatsApp (Meta API) ===
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=your_random_verify_token_here
WHATSAPP_PHONE_NUMBER_ID=
# Публичный URL без слэша на конце — для подсказки вебхука в админке (Meta Callback URL = PUBLIC_BASE_URL/api/whatsapp/webhook)
PUBLIC_BASE_URL=
# Дублировать ответ бота голосом после текста (edge-tts), если клиент прислал голосовое
# WHATSAPP_VOICE_REPLIES=false
# Голос Microsoft Edge TTS только для русского (detected_language=ru); kk/en/uz — свои нейронные голоса в коде
# EDGE_TTS_VOICE=ru-RU-SvetlanaNeural

# Telegram — оповещения при эскалации на оператора (escalate → HUMAN_MODE)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ADMIN_CHAT_ID=123456789
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Часовой пояс заведения в алертах Telegram (IANA). Пример РК: Asia/Almaty (UTC+5). Пусто — только UTC.
# DISPLAY_TIMEZONE=Asia/Almaty

# === Шифрование секретов в БД (опционально; для онбординга iiko из админки) ===
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_SECRETS_FERNET_KEY=
# Bearer для POST /api/webhooks/payment (оплата от провайдера → prepayment_status=paid)
# PAYMENT_WEBHOOK_BEARER_TOKEN=

# === iiko Cloud API (опционально) ===
IIKO_API_LOGIN=
IIKO_ORGANIZATION_ID=
# Терминальная группа (касса/точка): заказы в iiko + фильтр стоп-листа только по этой точке.
# Список UUID: python scripts/list_iiko_terminal_groups.py
# IIKO_TERMINAL_GROUP_ID=
# Товары в iiko Office для автострок заказа (создайте три позиции по ТЗ):
# IIKO_PRODUCT_ID_CONTAINER — общий fallback, если не заданы раздельно
# IIKO_PRODUCT_ID_CONTAINER_HALL=          # «Контейнер (Зал)»
# IIKO_PRODUCT_ID_CONTAINER_DELIVERY=       # «Контейнер (Доставка/самовывоз)»
# IIKO_PRODUCT_ID_DELIVERY=                 # услуга «Доставка» 700 ₸ (цена в номенклатуре)
# IIKO_PRODUCT_ID_CONTAINER=
# IIKO_PRODUCT_ID_DELIVERY=
# Тип заказа для iiko deliveries/create (UUID). Обязателен, иначе iiko вернёт 400.
# Можно задать один общий тип:
IIKO_ORDER_TYPE_ID=
# Или (рекомендуется) раздельно по типу получения:
# IIKO_ORDER_TYPE_ID_DELIVERY=   # доставка
# IIKO_ORDER_TYPE_ID_PICKUP=     # самовывоз
# IIKO_ORDER_TYPE_ID_HALL=       # в зале
# Принудительно отправлять ВСЕ заказы из ИИ-агента как "в зале"
# (чтобы быстрее искать их в общем потоке кассира/оператора).
# Требует корректный IIKO_ORDER_TYPE_ID_HALL.
# IIKO_FORCE_HALL_FOR_AI_ORDERS=true
# Только Dish / Good / Product при синхронизации (true = без Modifier/Ingredient и др.; false = вся номенклатура из API)
# IIKO_MENU_SYNC_ONLY_DISH_GOOD=false
# Фоновый импорт номенклатуры для всех филиалов с кредами (секунды). 0 = только ручная синхронизация в админке.
# Рекомендация prod: 3600–21600; слишком часто — лишняя нагрузка на iiko Cloud API.
# IIKO_MENU_AUTO_SYNC_INTERVAL_SECONDS=0

# Предоплата заказа: итог >= порога — клиент не подтвердит «Да», пока оператор не отметит оплату (paid/waived).
# ORDER_PREPAYMENT_THRESHOLD_KZT=15000
#
# Упаковка (цены ₸ и UUID номенклатуры iiko для строк в deliveries/create)
# PACKAGING_MANTY_UNIT_PRICE=200
# PACKAGING_PLOV_HALF_UNIT_PRICE=300
# PACKAGING_PLOV_1KG_TABAK_UNIT_PRICE=800
# PACKAGING_PLOV_1KG_FOIL_UNIT_PRICE=650
# IIKO_PRODUCT_ID_PACKAGING_MANTY=
# IIKO_PRODUCT_ID_PACKAGING_PLOV_HALF=
# IIKO_PRODUCT_ID_PACKAGING_PLOV_TABAK=
# IIKO_PRODUCT_ID_PACKAGING_PLOV_FOIL=

# === Тарификация заказов (v2), тенге ===
# Алиасы ТЗ: DELIVERY_FEE / DELIVERY_FREE_THRESHOLD (то же, что PRICING_*)
# PRICING_CONTAINER_HALL=0
# PRICING_CONTAINER_DELIVERY_PICKUP=250
# PRICING_DELIVERY_FEE=700
# DELIVERY_FEE=700
# PRICING_DELIVERY_FREE_THRESHOLD=10000
# DELIVERY_FREE_THRESHOLD=10000
# PRICING_CONTAINERS_PER_MAIN_UNIT=1
# Минимальная предоплата за бронь в зале (текст для бота и оператора)
# HALL_PREPAYMENT_MIN=5000

# === Предоплата / эквайринг (планируется; код: orders.prepayment_status, payment_link_url) ===
# В РК часто: Kaspi QR в зале, Kaspi Pay / Halyk для онлайн, Freedom Pay, PayBox, Stripe (редко).
# Интеграция: договор с банком или агрегатором → API создания платежа → webhook «оплачено» → prepayment_status=paid.
# Пока ссылку может вставить оператор в БД или через будущий PATCH; Kaspi не даёт публичного API «как Stripe» без мерчанта.
# PAYMENT_PROVIDER=none
# Kaspi / банк — только после подключения мерчанта (пример имён, не обязательны):
# KASPI_MERCHANT_ID=
# KASPI_SECRET=

# === Админ-панель ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_password_here
# Секрет cookie-сессии и подписи WS-токена (в проде — случайная строка 32+ байт)
SESSION_SECRET=
# Временный аварийный режим: разрешить старт в prod-like без SESSION_SECRET и/или с дефолтными кредами.
# Используйте только чтобы "разблокировать деплой", затем выключите и задайте нормальные секреты.
# ALLOW_INSECURE_PROD_SETTINGS=true

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=20

# === Sentry (опционально) ===
SENTRY_DSN=

# === Production Deploy (docker-compose.prod.yml) ===
DOMAIN=restomind.example.com
ACME_EMAIL=admin@example.com
